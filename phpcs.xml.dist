<?xml version="1.0"?>
<ruleset name="Lamp and Path">
	<description>WordPress coding standards for the lampandpath theme and the lampandpath-core plugin. Run with `ddev composer lint`.</description>

	<file>wp-content/themes/lampandpath</file>
	<file>wp-content/plugins/lampandpath-core</file>

	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/vendor/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="basepath" value="."/>
	<arg name="parallel" value="8"/>
	<arg name="colors"/>
	<arg value="sp"/>

	<!-- Match the theme and plugin headers: WordPress 6.5+, PHP 7.4+. -->
	<config name="minimum_wp_version" value="6.5"/>
	<config name="testVersion" value="7.4-"/>

	<rule ref="WordPress"/>
	<rule ref="PHPCompatibilityWP"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="lampandpath"/>
				<element value="lampandpath-core"/>
			</property>
		</properties>
	</rule>

	<!-- Template hierarchy files keep the post type's underscore, e.g. single-lp_plan.php. -->
	<rule ref="WordPress.Files.FileName">
		<properties>
			<property name="is_theme" value="true"/>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="lampandpath"/>
			</property>
		</properties>
	</rule>
</ruleset>
